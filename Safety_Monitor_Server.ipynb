def draw_sector_indicator(annotated_image, score, x, y, idx):
    # Define sector colors and angles
    sector_colors = [
        ((0, 255, 0) , 1 , 1),       # Green
        ((255, 255, 0), 2 , 2),     # Yellow
        ((255, 165, 0) , 4 , 4),     # Orange
        ((255, 0, 0), 7 , 3),      # Red
        ((139, 0, 0), 11 , 2)      # Dark Red
    ]
    
    radius = 50
    center = (x + radius, y + radius)
    arrow_length = radius

    cv2.ellipse(annotated_image, center, (radius, radius), 0, 180, 195, (0, 255, 0), -1)
    cv2.ellipse(annotated_image, center, (radius, radius), 0, 195, 225, (255, 255, 0), -1)
    cv2.ellipse(annotated_image, center, (radius, radius), 0, 225, 285, (255, 165, 0), -1)
    cv2.ellipse(annotated_image, center, (radius, radius), 0, 285, 330, (255, 0, 0), -1)
    cv2.ellipse(annotated_image, center, (radius, radius), 0, 330, 360, (139, 0, 0), -1)
   
    
    # Calculate arrow angle
    arrow_angle = 180 - (score - 1) * 9
    arrow_end = (
        int(center[0] + arrow_length * np.cos(np.radians(arrow_angle))),
        int(center[1] - arrow_length * np.sin(np.radians(arrow_angle)))
    )
    # Draw arrow
    cv2.arrowedLine(annotated_image, center, arrow_end, (255,255,255), 2, tipLength=0.1)
    cv2.rectangle(annotated_image, (x-10, y+radius+6), (x+100, y+radius+30), (0, 0, 0), -1, cv2.LINE_AA)
    #cv2.putText(annotated_image, f'person {idx+1}', (x, y+radius+20), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1, cv2.LINE_AA)
    cv2.putText(annotated_image, f'Score: {score}', (x, y+radius+20), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1, cv2.LINE_AA)


def draw_landmarks_on_image(rgb_image, detection_result):
    pose_landmarks_list = detection_result.pose_landmarks
    annotated_image = np.copy(rgb_image)

    # Loop through the detected poses to visualize.
    for idx in range(len(pose_landmarks_list)):
        pose_landmarks = pose_landmarks_list[idx]

        min_x, min_y, max_x, max_y = float('inf'), float('inf'), -float('inf'), -float('inf')
        # Calculate bounding box coordinates for the current person
        for landmark in pose_landmarks:
            min_x = min(min_x, landmark.x)
            min_y = min(min_y, landmark.y)
            max_x = max(max_x, landmark.x)
            max_y = max(max_y, landmark.y)

        width = max_x - min_x
        height = max_y - min_y
        min_x -= width * 0.1
        min_y -= height * 0.1
        max_x += width * 0.1
        max_y += height * 0.1
        
        pose_landmarks_proto = landmark_pb2.NormalizedLandmarkList()
        pose_landmarks_proto.landmark.extend([
            landmark_pb2.NormalizedLandmark(
                x=landmark.x,
                y=landmark.y,
                z=landmark.z) for landmark in pose_landmarks
        ])
        mp.solutions.drawing_utils.draw_landmarks(
            annotated_image,
            pose_landmarks_proto,
            mp.solutions.pose.POSE_CONNECTIONS,
            mp.solutions.drawing_styles.get_default_pose_landmarks_style()
        )
        
        landmarks_array = []
    
        for landmark_index, landmark in enumerate(pose_landmarks):
            landmarks_array.append([landmark_index, landmark.x, landmark.y, landmark.z])
        score = calculate_score(landmarks_array)
        # Draw bounding box for the current person
        cv2.rectangle(
            annotated_image,
            (int(min_x * annotated_image.shape[1]), int(min_y * annotated_image.shape[0])),
            (int(max_x * annotated_image.shape[1]), int(max_y * annotated_image.shape[0])),
            (255, 0, 0), 2
        )

        # Draw score indicator next to the bounding box
        indicator_x = int(max_x * annotated_image.shape[1]) + 10  # 10 pixels to the right of the bounding box
        indicator_y = int(min_y * annotated_image.shape[0])
        draw_sector_indicator(annotated_image, score, indicator_x, indicator_y, idx)
        
        check_high_risk_score(idx+1, score)
        check_very_high_risk_score(idx+1, score)
        check_low_risk_score(idx+1, score)
        check_low_very_high_risk_score(idx+1, score)
    return annotated_image

        


def calculate_angle2D(a,b,c):
    a = np.array(a) # First
    b = np.array(b) # Mid
    c = np.array(c) # End
    
    radians = np.arctan2(c[1]-b[1], c[0]-b[0]) - np.arctan2(a[1]-b[1], a[0]-b[0])
    angle = np.abs(radians*180.0/np.pi)
    
    if angle >180.0:
        angle = 360-angle
        
    return angle


def calculate_score(landmarks):
    score=1
    # Get coordinates
    nose = [landmarks[0][1], landmarks[0][2], landmarks[0][3]]
    left_ear = [landmarks[7][1], landmarks[7][2], landmarks[7][3]]
    right_ear = [landmarks[8][1], landmarks[8][2], landmarks[8][3]]
    left_shoulder = [landmarks[11][1], landmarks[11][2], landmarks[11][3]]
    right_shoulder = [landmarks[12][1], landmarks[12][2], landmarks[12][3]]
    left_elbow = [landmarks[13][1], landmarks[13][2], landmarks[13][3]]
    right_elbow = [landmarks[14][1], landmarks[14][2], landmarks[14][3]]
    left_wrist = [landmarks[15][1], landmarks[15][2], landmarks[15][3]]
    right_wrist = [landmarks[16][1], landmarks[16][2], landmarks[16][3]]
    left_index = [landmarks[19][1], landmarks[19][2], landmarks[19][3]]
    right_index = [landmarks[20][1], landmarks[20][2], landmarks[20][3]]
    left_hip = [landmarks[23][1], landmarks[23][2], landmarks[23][3]]
    right_hip = [landmarks[24][1], landmarks[24][2], landmarks[24][3]]
    left_knee = [landmarks[25][1], landmarks[25][2], landmarks[25][3]]
    right_knee = [landmarks[26][1], landmarks[26][2], landmarks[26][3]]
    left_ankle = [landmarks[27][1], landmarks[27][2], landmarks[27][3]]
    right_ankle = [landmarks[28][1], landmarks[28][2], landmarks[28][3]]
        
    neck = [(left_shoulder[0]+right_shoulder[0])/2, (left_shoulder[1]+right_shoulder[1])/2, (left_shoulder[2]+right_shoulder[2])/2]
    hip = [(left_hip[0]+right_hip[0])/2, (left_hip[1]+right_hip[1])/2, (left_hip[2]+right_hip[2])/2]
    trunk = [(neck[0]+hip[0])/2, (neck[1]+hip[1])/2, (neck[2]+hip[2])/2]
    ear = [(left_ear[0]+right_ear[0])/2, (left_ear[1]+right_ear[1])/2, (left_ear[2]+right_ear[2])/2]

     # Calculate other landmark
    extend = np.sqrt((trunk[0] - neck[0])**2 + (trunk[1] - neck[1])**2 + (trunk[2] - neck[2])**2)
    
    
    neck_vec2 = np.array([(trunk[0] - neck[0]), (trunk[1] - neck[1]), (trunk[2]-neck[2])])
    scaled_neck_vec2 = (extend / np.linalg.norm(neck_vec2)) * neck_vec2
    trunk_neck_vec = [(neck[0]-scaled_neck_vec2[0]), (neck[1]-scaled_neck_vec2[1]), (neck[2]-scaled_neck_vec2[2])]
    
    trunk_vertical = [trunk[0],trunk[1]-extend,trunk[2]]
    
    left_wrist_vec = np.array([(left_elbow[0] - left_wrist[0]), (left_elbow[1] - left_wrist[1]), (left_elbow[2]-left_wrist[2])])
    scaled_left_wrist_vec = (extend / np.linalg.norm(left_wrist_vec)) * left_wrist_vec
    left_elbow_wrist_vec = [(left_wrist[0]-scaled_left_wrist_vec[0]), (left_wrist[1]-scaled_left_wrist_vec[1]), (left_wrist[2]-scaled_left_wrist_vec[2])]

    right_wrist_vec = np.array([(right_elbow[0] - right_wrist[0]), (right_elbow[1] - right_wrist[1]), (right_elbow[2]-right_wrist[2])])
    scaled_right_wrist_vec = (extend / np.linalg.norm(right_wrist_vec)) * right_wrist_vec
    right_elbow_wrist_vec = [(right_wrist[0]-scaled_right_wrist_vec[0]), (right_wrist[1]-scaled_right_wrist_vec[1]), (right_wrist[2]-scaled_right_wrist_vec[2])]  

     #calculate angle
    angle_neck = calculate_angle2D([trunk_neck_vec[0],trunk_neck_vec[1]], [neck[0],neck[1]], [nose[0],nose[1]])
    angle_neck = round(angle_neck,2)

    angle_trunk = calculate_angle2D([trunk_vertical[0],trunk_vertical[1]], [trunk[0],trunk[1]], [neck[0],neck[1]])
    angle_trunk = round(angle_trunk,2)
    
    angle_left_leg = calculate_angle2D([left_ankle[0],left_ankle[1]], [left_knee[0],left_knee[1]], [left_hip[0],left_hip[1]])
    angle_left_leg = 180-angle_left_leg
    angle_left_leg = round(angle_left_leg,2)
    

    angle_right_leg = calculate_angle2D([right_ankle[0],right_ankle[1]], [right_knee[0],right_knee[1]], [right_hip[0],right_hip[1]])
    angle_right_leg = 180-angle_right_leg
    angle_right_leg = round(angle_right_leg,2)
    

    angle_left_upper_arm = calculate_angle2D([trunk[0],trunk[1]], [left_shoulder[0],left_shoulder[1]], [left_elbow[0],left_elbow[1]])
    angle_left_upper_arm = round(angle_left_upper_arm,2)

    angle_right_upper_arm = calculate_angle2D([trunk[0],trunk[1]], [right_shoulder[0],right_shoulder[1]], [right_elbow[0],right_elbow[1]])
    angle_right_upper_arm = round(angle_right_upper_arm,2)
    

    angle_left_lower_arm = calculate_angle2D([left_shoulder[0], left_shoulder[1]], [left_elbow[0], left_elbow[1]], [left_wrist[0], left_wrist[1]])
    angle_left_lower_arm = 180-angle_left_lower_arm
    angle_left_lower_arm = round(angle_left_lower_arm, 2)


    angle_right_lower_arm = calculate_angle2D([right_shoulder[0], right_shoulder[1]], [right_elbow[0], right_elbow[1]], [right_wrist[0], right_wrist[1]])
    angle_right_lower_arm = 180-angle_right_lower_arm
    angle_right_lower_arm = round(angle_right_lower_arm, 2)
    

    angle_left_wrist = calculate_angle2D([left_elbow_wrist_vec[0], left_elbow_wrist_vec[1]], [left_wrist[0], left_wrist[1]], [left_index[0], left_index[1]])
    angle_left_wrist = round(angle_left_wrist, 2)
    

    angle_right_wrist = calculate_angle2D([right_elbow_wrist_vec[0], right_elbow_wrist_vec[1]], [right_wrist[0], right_wrist[1]], [right_index[0], right_index[1]])
    angle_right_wrist = round(angle_right_wrist, 2)

    scoreA=0
    scoreB=0
    scoreleg=0
    scoreupper_arm=0
    scorelower_arm=0
    scorewrist=0

    if(angle_neck>=0 and angle_neck<=20):
        score_neck=1
    else:
        score_neck=2

    if(angle_trunk==0):
        score_trunk=1
    elif(angle_trunk>=-20 and angle_trunk<=20):
        score_trunk=2
    elif(angle_trunk<-20 or (angle_trunk>20 and angle_trunk<=60)):
