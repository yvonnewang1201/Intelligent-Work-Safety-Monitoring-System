# 儲存每個客戶端的to_window
client_windows = {}
last_timestamps = {}

def print_result(detection_result: vision.PoseLandmarkerResult, output_image: mp.Image,
                 timestamp_ms: int, window_name: str):
    # 在這裡不添加任何變數
    if timestamp_ms < last_timestamps.get(window_name, 0):
        return
    last_timestamps[window_name] = timestamp_ms

    to_window = cv2.cvtColor(
        draw_landmarks_on_image(output_image.numpy_view(), detection_result), cv2.COLOR_RGB2BGR)

    # 更新對應的客戶端窗口
    client_windows[window_name] = to_window

def handle_client(client_socket, addr):
    print(f"Connection from: {addr}")
    data = b""
    payload_size = struct.calcsize("I")  # 消息大小的打包格式
    window_name = f"Client {addr}"  # 為每個客戶端創建唯一的視窗名稱
    client_windows[window_name] = None  # 初始化窗口
    last_timestamps[window_name] = 0  # 初始化時間戳

    # 在這裡為每個客戶端創建新的 MediaPipe 模型
    base_options = python.BaseOptions(model_asset_buffer=open(model_path, "rb").read())
    options = vision.PoseLandmarkerOptions(
        base_options=base_options,
        running_mode=vision.RunningMode.LIVE_STREAM,
        num_poses=num_poses,
        min_pose_detection_confidence=min_pose_detection_confidence,
        min_pose_presence_confidence=min_pose_presence_confidence,
        min_tracking_confidence=min_tracking_confidence,
        output_segmentation_masks=False,
        result_callback=lambda result, img, ts: print_result(result, img, ts, window_name)  # 傳遞 window_name
    )

    with vision.PoseLandmarker.create_from_options(options) as landmarker:
        while True:
            try:
                # 确保接收到的字节数足够提取消息大小
                while len(data) < payload_size:
                    packet = client_socket.recv(4096)
                    if not packet:
                        print(f"Connection closed by {addr}")
                        return
                    data += packet

                packed_msg_size = data[:payload_size]
                data = data[payload_size:]
                msg_size = struct.unpack("I", packed_msg_size)[0]

                # 确保接收到完整的消息（即压缩后的图像数据）
                while len(data) < msg_size:
                    data += client_socket.recv(4096)

                frame_data = data[:msg_size]
                data = data[msg_size:]

                # 反序列化压缩后的 JPEG 数据
                compressed_frame = pickle.loads(frame_data)

                # 使用 OpenCV 解压缩图像数据（JPEG 解码）
                frame = cv2.imdecode(compressed_frame, cv2.IMREAD_COLOR)

                # Convert the frame received from OpenCV to a MediaPipe’s Image object.
                mp_image = mp.Image(
                    image_format=mp.ImageFormat.SRGB,
                    data=cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
                timestamp_ms = int(cv2.getTickCount() / cv2.getTickFrequency() * 1000)

                # 使用 MediaPipe 進行姿勢檢測
                result = landmarker.detect_async(mp_image, timestamp_ms)

                # 显示来自客户端的图像
                if client_windows[window_name] is not None:
                    cv2.imshow(window_name, client_windows[window_name])

                if cv2.waitKey(1) & 0xFF == ord('q'):
                    break
            except Exception as e:
                print(f"Error handling client {addr}: {e}")
                break

    client_socket.close()

def main():
    # 设置服务器地址和端口
    server_ip = '192.168.50.36'
    server_port = 5555

    # 创建套接字
    server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server_socket.bind((server_ip, server_port))
    server_socket.listen(10)

    print(f"Server is listening on {server_ip}:{server_port}")

    while True:
        # 接受客户端连接
        client_socket, addr = server_socket.accept()

        # 为每个客户端连接创建一个新的线程
        client_thread = threading.Thread(target=handle_client, args=(client_socket, addr))
        client_thread.start()

if __name__ == "__main__":
    main()
