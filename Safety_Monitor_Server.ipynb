# 檢查是否超過高風險閾值，如果是，開始計時
def check_high_risk_score(person_id, score):
    global high_risk_times
    if score >= 8:
         # 如果該人員尚未在高風險時間中，則開始計時
        if person_id not in high_risk_times:
            high_risk_times[person_id] = time.time()
            print(f"Person {person_id}: High risk detected. Timer started.")
       
    

# 檢查是否超過非常高風險閾值，如果是，開始計時
def check_very_high_risk_score(person_id, score):
    global very_high_risk_times
    if score >= 11:
        # 如果該人員尚未在非常高風險時間中，則開始計時
        if person_id not in very_high_risk_times:
            very_high_risk_times[person_id] = time.time()
            print(f"Person {person_id}: Very high risk detected. Timer started.")

# 檢查是否低於高風險閾值，如果是，停止計時
def check_low_risk_score(person_id, score):
    global high_risk_times
    if person_id in high_risk_times and score < 8:
        # 如果該人員正在高風險時間中，則停止計時並計算經過的時間
        elapsed_time = time.time() - high_risk_times.pop(person_id)
        print(f"Person {person_id}: High risk resolved. Elapsed time: {elapsed_time} seconds.")

# 檢查是否低於非常高風險閾值，如果是，停止計時
def check_low_very_high_risk_score(person_id, score):
    global very_high_risk_times
    if person_id in very_high_risk_times and score < 11:
        # 如果該人員正在非常高風險時間中，則停止計時並計算經過的時間
        elapsed_time = time.time() - very_high_risk_times.pop(person_id)
        print(f"Person {person_id}: Very high risk resolved. Elapsed time: {elapsed_time} seconds.")

def stop_all_timers():
    global high_risk_times
    global very_high_risk_times
    print("Stopping all timers...")
    # 檢查高風險計時器並停止計時
    for person_id, start_time in high_risk_times.items():
        elapsed_time = time.time() - start_time
        print(f"Person {person_id}: High risk resolved. Elapsed time: {elapsed_time} seconds.")
    #high_risk_times = {}
    
    # 檢查非常高風險計時器並停止計時
    for person_id, start_time in very_high_risk_times.items():
        elapsed_time = time.time() - start_time
        print(f"End Person {person_id}: Very high risk resolved. Elapsed time: {elapsed_time} seconds.")
